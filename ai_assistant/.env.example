# Supabase Credentials (from Supabase Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-key

# Ollama LLM Configuration (Running locally or on a remote GPU server)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_SECONDS=60

# FastAPI Microservice Configuration (For backend teammate to connect over HTTP)
ASSISTANT_HOST=0.0.0.0
ASSISTANT_PORT=8005
DEBUG=False
